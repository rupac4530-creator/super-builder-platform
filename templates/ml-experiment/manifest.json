            "json"
        ],
        "outputFormats": [
            "pytorch",
            "onnx",
            "tensorrt"
        ]
    },
    "features": [
        "Mixed precision (FP16) training",
        "Automatic hyperparameter tuning",
        "Early stopping",
        "Model checkpointing",
        "ONNX export",
        "GPU memory optimization"
    ]
