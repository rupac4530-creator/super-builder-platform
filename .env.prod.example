# ============================================
# Engine Alto — Production Environment Config
# ============================================
# Copy to .env and fill in real values.
# NEVER commit .env with real secrets.

# ---- Server ----
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-domain.com

# ---- Database ----
# Use Kubernetes secret or Vault in production
DATABASE_URL=postgresql://alto:REPLACE_ME@db-host:5432/alto_db

# ---- Redis ----
REDIS_URL=redis://redis-host:6379

# ---- Job Queue ----
# Options: redis | memory
# ALWAYS use redis in production
JOB_QUEUE=redis

# ---- AI Configuration ----
ENABLE_REAL_AI=true
OPENAI_API_KEY=REPLACE_ME_VIA_VAULT_OR_K8S_SECRET
AI_MODEL=gpt-4
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_MS=1000
AI_REQUEST_TIMEOUT_MS=30000
AI_COST_LIMIT_PER_REQUEST_USD=0.50
AI_MONTHLY_BUDGET_USD=100.00

# ---- AI Training ----
TRAINING_DATA_DIR=/data/datasets
MODELS_DIR=/data/models
CHECKPOINTS_DIR=/data/checkpoints
MAX_GPU_MEMORY_MB=5500
MIXED_PRECISION=true

# ---- Storage ----
UPLOAD_DIR=/data/uploads
EXPORTS_DIR=/data/exports
PREVIEWS_DIR=/data/previews

# ---- Authentication ----
JWT_SECRET=REPLACE_ME_MIN_64_CHARS_HIGH_ENTROPY
SESSION_SECRET=REPLACE_ME_MIN_64_CHARS_HIGH_ENTROPY

# ---- Content Moderation ----
CONTENT_MODERATION_ENABLED=true
CONTENT_MODERATION_STRICTNESS=high
ENABLE_VOICE_GENERATION=false
ENABLE_IMAGE_GENERATION=false

# ---- Telemetry ----
ENABLE_TELEMETRY=true
PROMETHEUS_PORT=9090

# ---- External Services ----
# Store these in Vault/K8s Secrets — not here
GITHUB_TOKEN=REPLACE_ME_VIA_VAULT
VERCEL_TOKEN=REPLACE_ME_VIA_VAULT
AWS_ACCESS_KEY_ID=REPLACE_ME_VIA_VAULT
AWS_SECRET_ACCESS_KEY=REPLACE_ME_VIA_VAULT
AWS_REGION=us-east-1
S3_BUCKET=engine-alto-assets

# ---- Host Tools (for verify_host script) ----
# These are validated by scripts/verify_host.sh
# Required: node, python, git, docker
# Optional: ffmpeg, blender, nvidia-smi
REQUIRE_GPU=false
REQUIRE_FFMPEG=false
REQUIRE_BLENDER=false
