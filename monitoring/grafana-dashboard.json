{
    "annotations": {
        "list": []
    },
    "description": "Super Builder Platform — Operations Dashboard",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
        {
            "title": "API Request Rate",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "rate(superbuilder_http_requests_total[5m])",
                    "legendFormat": "{{method}} {{path}}"
                }
            ]
        },
        {
            "title": "API Latency (p95)",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, rate(superbuilder_http_request_duration_seconds_bucket[5m]))",
                    "legendFormat": "p95"
                },
                {
                    "expr": "histogram_quantile(0.50, rate(superbuilder_http_request_duration_seconds_bucket[5m]))",
                    "legendFormat": "p50"
                }
            ]
        },
        {
            "title": "Jobs Overview",
            "type": "stat",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "expr": "superbuilder_jobs_total",
                    "legendFormat": "Total"
                },
                {
                    "expr": "superbuilder_jobs_processed_total",
                    "legendFormat": "Processed"
                },
                {
                    "expr": "superbuilder_jobs_failed_total",
                    "legendFormat": "Failed"
                }
            ]
        },
        {
            "title": "Queue Size",
            "type": "gauge",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 8,
                "y": 8
            },
            "targets": [
                {
                    "expr": "superbuilder_queue_size",
                    "legendFormat": "Pending"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": 0
                            },
                            {
                                "color": "yellow",
                                "value": 50
                            },
                            {
                                "color": "red",
                                "value": 100
                            }
                        ]
                    },
                    "max": 200
                }
            }
        },
        {
            "title": "Job Processing Rate",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "expr": "rate(superbuilder_jobs_processed_total[5m])",
                    "legendFormat": "Processed/s"
                },
                {
                    "expr": "rate(superbuilder_jobs_failed_total[5m])",
                    "legendFormat": "Failed/s"
                }
            ]
        },
        {
            "title": "Memory Usage",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 16
            },
            "targets": [
                {
                    "expr": "process_resident_memory_bytes{job='superbuilder-backend'}",
                    "legendFormat": "Backend RSS"
                },
                {
                    "expr": "process_resident_memory_bytes{job='superbuilder-worker'}",
                    "legendFormat": "Worker RSS"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                }
            }
        },
        {
            "title": "GPU Workers",
            "type": "stat",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 16
            },
            "targets": [
                {
                    "expr": "superbuilder_gpu_workers_active",
                    "legendFormat": "Active GPU Workers"
                },
                {
                    "expr": "superbuilder_gpu_queue_size",
                    "legendFormat": "GPU Queue"
                }
            ]
        },
        {
            "title": "Redis",
            "type": "stat",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 16
            },
            "targets": [
                {
                    "expr": "redis_connected_clients",
                    "legendFormat": "Clients"
                },
                {
                    "expr": "redis_used_memory_bytes",
                    "legendFormat": "Memory"
                }
            ]
        },
        {
            "title": "AI Cost Tracking",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 20
            },
            "targets": [
                {
                    "expr": "rate(superbuilder_ai_tokens_used_total[1h])",
                    "legendFormat": "Tokens/hr"
                },
                {
                    "expr": "rate(superbuilder_ai_cost_dollars_total[1h])",
                    "legendFormat": "Cost $/hr"
                }
            ]
        }
    ],
    "schemaVersion": 38,
    "style": "dark",
    "tags": [
        "superbuilder",
        "operations"
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "title": "Super Builder Platform — Operations",
    "uid": "superbuilder-ops",
    "version": 1
}