# ==============================
# Engine Alto — Environment Config
# ==============================

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://alto:alto_secret@localhost:5432/alto_db

# Redis
REDIS_URL=redis://localhost:6379

# AI Configuration
ENABLE_REAL_AI=false
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_MODEL=gpt-4

# AI Training
TRAINING_DATA_DIR=./data/datasets
MODELS_DIR=./data/models
CHECKPOINTS_DIR=./data/checkpoints
MAX_GPU_MEMORY_MB=5500
MIXED_PRECISION=true

# Storage
UPLOAD_DIR=./data/uploads
EXPORTS_DIR=./data/exports
PREVIEWS_DIR=./data/previews

# Authentication
JWT_SECRET=change-this-to-a-random-string
SESSION_SECRET=change-this-too

# Telemetry (opt-in)
ENABLE_TELEMETRY=false
PROMETHEUS_PORT=9090

# AI Providers (add your own keys)
GEMINI_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
OPENROUTER_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Agent Hub (OpenClaw)
FEATURE_AGENT_HUB=true
AGENT_HUB_USE_LLM=false
AGENT_HUB_LLM_TIMEOUT_MS=5000
AGENT_HUB_DRY_RUN=true

# External Services (optional)
GITHUB_TOKEN=
VERCEL_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=engine-alto-assets
