# ==============================
# Engine Alto — Environment Config
# ==============================

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://alto:alto_secret@localhost:5432/alto_db

# Redis
REDIS_URL=redis://localhost:6379

# AI Configuration
ENABLE_REAL_AI=false
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_MODEL=gpt-4

# AI Training
TRAINING_DATA_DIR=./data/datasets
MODELS_DIR=./data/models
CHECKPOINTS_DIR=./data/checkpoints
MAX_GPU_MEMORY_MB=5500
MIXED_PRECISION=true

# Storage
UPLOAD_DIR=./data/uploads
EXPORTS_DIR=./data/exports
PREVIEWS_DIR=./data/previews

# Authentication
JWT_SECRET=change-this-to-a-random-string
SESSION_SECRET=change-this-too

# Telemetry (opt-in)
ENABLE_TELEMETRY=false
PROMETHEUS_PORT=9090

# External Services (optional)
GITHUB_TOKEN=
VERCEL_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=engine-alto-assets
