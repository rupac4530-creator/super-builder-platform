# ============================================
# SuperBuilder Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env — it is in .gitignore.
# For CI/CD, add these as GitHub Secrets.
# ============================================

# --- Backend ---
PORT=4000
NODE_ENV=development

# --- AI / LLM ---
# Google Gemini (free tier from https://aistudio.google.com/apikey)
GEMINI_API_KEY=REPLACE_ME

# OpenAI (optional fallback)
OPENAI_API_KEY=REPLACE_ME

# --- Audio ---
# Minimax (https://www.minimax.chat)
MINIMAX_API_KEY=REPLACE_ME

# --- Video ---
# Runway ML (https://dev.runwayml.com)
RUNWAY_API_KEY=REPLACE_ME

# --- Design ---
# Figma (https://www.figma.com/developers)
FIGMA_API_TOKEN=REPLACE_ME

# --- Ideas / Data ---
# Reddit (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=REPLACE_ME
REDDIT_CLIENT_SECRET=REPLACE_ME

# --- Avatars ---
# HeyGen (https://www.heygen.com/developers)
HEYGEN_API_KEY=REPLACE_ME

# --- Database (optional) ---
REDIS_URL=redis://localhost:6379

# --- GPU (auto-detected, override if needed) ---
# CUDA_VISIBLE_DEVICES=0
